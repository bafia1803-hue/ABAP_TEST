{
    "_version": "1.59.0",
    "sap.app": {
        "id": "zwb.rcz",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.2.4"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "dataSources": {
            "mainService": {
                "uri": "/sap/opu/odata4/sap/zui_wb_rcz_day_o4/srvd/sap/zui_wb_rcz_day/0001/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": false,
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.fe.templates": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "zwb.rcz.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "routing": {
            "config": {},
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "TimeResultDayList",
                    "target": "TimeResultDayList"
                },
                {
                    "pattern": "TimeResultDay({key}):?query:",
                    "name": "TimeResultDayObjectPage",
                    "target": "TimeResultDayObjectPage"
                },
                {
                    "pattern": "Messages/{pernr}/{fpper}",
                    "name": "Messages",
                    "target": "Messages"
                }
            ],
            "targets": {
                "TimeResultDayList": {
                    "type": "Component",
                    "id": "TimeResultDayList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/TimeResultDay",
                            "variantManagement": "Page",
                            "initialLoad": "Disabled",
                            "navigation": {
                                "TimeResultDay": {
                                    "detail": {
                                        "route": "TimeResultDayObjectPage"
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "GridTable",
                                        "selectionMode": "None",
                                        "rowCountMode": "Auto",
                                        "condensedTableLayout": true,
                                        "enableExport": true,
                                        "personalization": true
                                    },
                                    "actions": {
                                        "hideEmptyColumns": {
                                            "press": ".extension.zwb.rcz.ext.ListReportExt.hideEmptyColumns",
                                            "text": "{i18n>hideEmptyColumns}",
                                            "enabled": true,
                                            "requiresSelection": false
                                        },
                                        "showAllColumns": {
                                            "press": ".extension.zwb.rcz.ext.ListReportExt.showAllColumns",
                                            "text": "{i18n>showAllColumns}",
                                            "enabled": true,
                                            "requiresSelection": false
                                        }
                                    },
                                    "columns": {
                                        "MsgCell": {
                                            "header": "{i18n>colMessages}",
                                            "template": "zwb.rcz.ext.fragment.MessageBadgesCell",
                                            "width": "6rem",
                                            "horizontalAlign": "Center",
                                            "properties": [
                                                "ErrorCount",
                                                "WarningCount"
                                            ],
                                            "position": {
                                                "anchor": "DateCell",
                                                "placement": "Before"
                                            }
                                        },
                                        "DateCell": {
                                            "header": "{i18n>colDate}",
                                            "template": "zwb.rcz.ext.fragment.DateCell",
                                            "width": "7rem",
                                            "horizontalAlign": "Begin",
                                            "properties": [
                                                "Datcz"
                                            ],
                                            "position": {
                                                "anchor": "DataField::PlanTime",
                                                "placement": "Before"
                                            }
                                        },
                                        "WeekdayCell": {
                                            "header": "{i18n>colWeekday}",
                                            "template": "zwb.rcz.ext.fragment.WeekdayCell",
                                            "width": "8rem",
                                            "horizontalAlign": "Begin",
                                            "properties": [
                                                "DayOfWeek"
                                            ],
                                            "position": {
                                                "anchor": "DateCell",
                                                "placement": "After"
                                            }
                                        },
                                        "DataField::PlanTime": {
                                            "width": "5rem"
                                        },
                                        "DataField::WorkedTime": {
                                            "width": "5rem"
                                        },
                                        "DataField::Shortage": {
                                            "width": "5rem"
                                        },
                                        "DataField::SkippedTime": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtDailyBd": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtDaily50": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtDailyComp": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtDaily100": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtAvgPaidBd": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtAvgPaid": {
                                            "width": "5rem"
                                        },
                                        "DataField::OvtAvgComp": {
                                            "width": "5rem"
                                        },
                                        "DataField::ExtraHours": {
                                            "width": "5rem"
                                        },
                                        "DataField::Extra50": {
                                            "width": "5rem"
                                        },
                                        "DataField::Extra100": {
                                            "width": "5rem"
                                        },
                                        "DataField::OnCall": {
                                            "width": "5rem"
                                        },
                                        "DataField::SecondShift": {
                                            "width": "5rem"
                                        },
                                        "DataField::NightHours": {
                                            "width": "5rem"
                                        },
                                        "DataField::SundayHoliday": {
                                            "width": "5rem"
                                        },
                                        "DataField::DaysToGive": {
                                            "width": "5rem"
                                        },
                                        "DataField::DaysTaken": {
                                            "width": "5rem"
                                        },
                                        "DataField::Absence": {
                                            "width": "5rem"
                                        },
                                        "DataField::AbsencePaid": {
                                            "width": "5rem"
                                        },
                                        "DataField::PrivExitWork": {
                                            "width": "5rem"
                                        },
                                        "DataField::PrivExitDeduct": {
                                            "width": "5rem"
                                        },
                                        "DataField::MakeUpHours": {
                                            "width": "5rem"
                                        },
                                        "DataField::PrivExitBalance": {
                                            "width": "5rem"
                                        }
                                    }
                                }
                            },
                            "content": {
                                "header": {
                                    "actions": {
                                        "zwbMessages": {
                                            "press": ".extension.zwb.rcz.ext.ListReportExt.openAllMessages",
                                            "text": "{i18n>messagesButton}"
                                        },
                                        "zwbTheme": {
                                            "press": ".extension.zwb.rcz.ext.ListReportExt.toggleTheme",
                                            "text": "{i18n>themeDark}",
                                            "position": {
                                                "placement": "After",
                                                "anchor": "zwbMessages"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "TimeResultDayObjectPage": {
                    "type": "Component",
                    "id": "TimeResultDayObjectPage",
                    "name": "sap.fe.core.fpm",
                    "options": {
                        "settings": {
                            "viewName": "zwb.rcz.ext.view.DayTimeline",
                            "contextPath": "/TimeResultDay"
                        }
                    }
                },
                "Messages": {
                    "type": "Component",
                    "id": "Messages",
                    "name": "sap.fe.core.fpm",
                    "options": {
                        "settings": {
                            "viewName": "zwb.rcz.ext.view.Messages",
                            "contextPath": "/TimeMessage"
                        }
                    }
                }
            }
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.fe.templates.ListReport.ListReportController": {
                        "controllerName": "zwb.rcz.ext.ListReportExt"
                    }
                }
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    }
}
