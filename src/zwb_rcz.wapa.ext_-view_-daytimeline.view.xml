<mvc:View
    controllerName="zwb.rcz.ext.view.DayTimeline"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:zwb="zwb.rcz.ext.control">
    <!-- Oś czasu dnia: własna kontrolka (ext/control/DayTimeline.js) z animowaną zmianą dnia -->
    <Page
        id="dayTimelinePage"
        title="{i18n>timelinePageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <content>
            <zwb:DayTimeline
                id="dayTimeline"
                prevText="{i18n>timelinePrev}"
                nextText="{i18n>timelineNext}"
                emptyText="{i18n>timelineEmpty}"
                hintText="{i18n>timelineHint}"
                navigate=".onNavigateDay" />
        </content>
    </Page>
</mvc:View>
